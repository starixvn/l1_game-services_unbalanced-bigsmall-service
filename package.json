{
    "name": "treasure-island-service",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "scripts": {
        "test": "jest --testPathPattern=unit-tests",
        "test-coverage": "jest --collect-coverage --testPathPattern=unit-tests",
        "dev": "nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
        "debug": "nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
        "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
        "reg": "npm set registry http://npm.lumigame.com",
        "integration-test": "jest --config ./jest.integration-test.config.cjs --testPathPattern=tests/integration-tests/ --ci --forceExit --runInBand"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "author": "pentagon",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "chance": "^1.1.8",
        "nodemon": "^2.0.4",
        "random": "^3.0.6",
        "random-js": "^2.1.0",
        "sc-multiple-games-base": "1.6.1-beta.1"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.11.5",
        "@commitlint/cli": "^9.1.2",
        "@commitlint/config-conventional": "^9.1.2",
        "@semantic-release/changelog": "^5.0.1",
        "@semantic-release/commit-analyzer": "^8.0.1",
        "@semantic-release/git": "^9.0.0",
        "@semantic-release/gitlab": "^6.0.4",
        "@semantic-release/npm": "^7.0.5",
        "@semantic-release/release-notes-generator": "^9.0.1",
        "@types/jest": "^28.1.6",
        "babel-jest": "^26.6.0",
        "babel-plugin-rewire": "^1.2.0",
        "husky": "^4.2.5",
        "install": "^0.13.0",
        "jest": "^26.6.3",
        "jest-extended": "^0.11.5",
        "jest-html-reporters": "^3.0.10",
        "jest-junit": "^13.2.0",
        "jest-micro-auto-stub": "^1.0.6",
        "jest-sonar-reporter": "^2.0.0",
        "sc-game-service-integration-utils": "1.3.0",
        "sc-semantic-release": "^1.1.0",
        "semantic-release": "^17.1.1"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
